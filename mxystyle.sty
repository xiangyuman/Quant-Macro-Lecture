% ===== 排版设置 =====

% 页面
\setlength{\headheight}{15pt} % 防止页眉高度警告
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\leftmark} % 靠左显示章标题
%\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\color{Blue!60} \hrule width\textwidth height 0.8pt} % 蓝色页眉线
\fancyfoot[C]{\thepage}

% 目录
\setcounter{secnumdepth}{4}    % 支持四级编号
\setcounter{tocdepth}{4}       % 目录显示到第四级

\renewcommand{\thepart}{\Roman{part}}   % 篇：罗马数字
\renewcommand{\thechapter}{\arabic{chapter}} % 章：阿拉伯数字
\renewcommand{\thesection}{\thechapter.\arabic{section}} % 1.1
\renewcommand{\thesubsection}{\thesection.\arabic{subsection}} % 1.1.1

%  目录格式
% \dottedcontents{part}[4em]{\addvspace{1em}\bfseries}{4em}{1pc}
% \dottedcontents{chapter}[2.5em]{\addvspace{0.5em}}{2.3em}{1pc}
% \dottedcontents{section}[4.5em]{}{3.2em}{1pc}
% \dottedcontents{subsection}[7em]{}{4.2em}{1pc}

% part篇格式设置 
\titleformat{\part}[block]
  {\filcenter\Huge\bfseries\sffamily}
  {Part \thepart} % 编号前缀
  {1em}
  {}
\titlespacing*{\part}{0pt}{3cm}{3cm}

% chapter章格式设置 
\titleformat{\chapter}[block]
    {\LARGE\bfseries\sffamily}
    {\thechapter}
    {1em}   % 编号与标题间距
    {}  % 标题前内容
\titlespacing{\chapter}{0pt}{2\baselineskip}{1\baselineskip}

% section节格式设置
\titleformat{\section}[block]
    {\large\bfseries\sffamily}
    {\thesection}
    {1em}
    {}
 \titlespacing{\section}{0pt}{1.2\baselineskip}{0.6\baselineskip}

% subsection子节格式设置
\titleformat{\subsection}[block]
    {\large\bfseries\sffamily}
    {\thesubsection}
    {1em}
    {}
\titlespacing{\subsection}{0pt}{0.8\baselineskip}{0.4\baselineskip}