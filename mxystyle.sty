%% customlized package
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{mxystyle}


%% =============== 中英文字体配置 ===============
\RequirePackage[UTF8,fontset=windows]{ctex} % 中文包


%% =============== 页面布局 ===============
\RequirePackage{geometry} % 页面布局
\RequirePackage{fancyhdr} % 页面、页眉

% ===== 页面大小 =====
\geometry{inner=2.5cm, outer=2.5cm, top=2.5cm, bottom=2.5cm, bindingoffset=0.5cm}


% ===== 前言、正文部分页码控制 =====
% 取消frontmatter页码
\fancypagestyle{frontstyle}{
    \fancyhf{}
    \renewcommand{\headrulewidth}{0pt}
}
% 取消目录页码
\fancypagestyle{tocstyle}{
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
}
% 正文页码样式
\fancypagestyle{mainstyle}{
    \fancyhf{}
    \fancyfoot[C]{\thepage}
    \renewcommand{\headrulewidth}{0.4pt}
}
% 自动应用页码样式
\AtBeginDocument{
  \pagestyle{frontstyle} % 文档开始时应用无页码样式
  \let\oldtableofcontents\tableofcontents % 重定义目录命令
  \renewcommand{\tableofcontents}{
    \pagestyle{tocstyle} % 应用目录专用样式
    \oldtableofcontents
    \thispagestyle{tocstyle} % 确保目录第一页无页码
    \cleardoublepage
  }
}
% 增强frontmatter命令
\let\oldfrontmatter\frontmatter
\renewcommand{\frontmatter}{
  \oldfrontmatter
  \pagestyle{frontstyle} % 确保前言部分应用无页码样式
  \pagenumbering{gobble} % 完全禁用页码编号
}
% 增强mainmatter命令
\let\oldmainmatter\mainmatter
\renewcommand{\mainmatter}{
  \oldmainmatter
  \pagestyle{mainstyle} % 应用正文页码样式
  \pagenumbering{arabic} % 启用阿拉伯数字页码
}

% ===== 页眉控制 =====
\setlength{\headheight}{15pt} % 防止页眉高度警告
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\footnotesize\leftmark} % 靠左显示章标题
%\renewcommand{\headrulewidth}{0.4pt}
\renewcommand{\headrule}{\color{Blue!60} \hrule width\textwidth height 0.8pt} % 蓝色页眉线
\fancyfoot[C]{\thepage}

% ===== 目录 =====
\setcounter{secnumdepth}{4}    % 支持四级编号
\setcounter{tocdepth}{4}       % 目录显示到第四级


%% =============== 数学环境 ===============
\RequirePackage{amsmath, amssymb, amsthm, bm, mathtools, bbm, etoolbox} % 公式

%% =============== 引用环境 ===============
\RequirePackage{hyperref,cleveref}  % 引用

% ===== 文中引用设定 =====
\hypersetup{
    colorlinks = true,
    linkcolor = blue,
    citecolor = red,
    urlcolor = cyan
}

% ===== 引用名称 ====
\crefname{equation}{式}{式}
\crefname{figure}{图}{图}
\crefname{definition}{定义}{定义}
\crefname{theorem}{定理}{定理}
\crefname{lemma}{引理}{引理}
\crefname{property}{性质}{性质}
\crefname{example}{例}{例}
\crefname{assumption}{假设}{假设}


%% ================ 图环境 ===============
\RequirePackage{graphicx, subcaption,float} % 图片
\RequirePackage{caption}
\RequirePackage{tikz}


%% =============== 代码环境 ===============
\RequirePackage{listings}
\RequirePackage[framed,numbered,autolinebreaks]{mcode}  % matlab code in context


%% =============== 定义、定理、引理、性质、例、假设 环境 ===============
\RequirePackage[most, listings, theorems]{tcolorbox}
\RequirePackage{siunitx, mdframed}
\RequirePackage[dvipsnames]{xcolor} % 自定义环境外观

